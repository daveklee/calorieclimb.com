# Supabase Configuration (Required for API features)
# Get these from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Google Analytics Measurement ID (Optional)
# Get your measurement ID from Google Analytics 4
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=your_ga_measurement_id_here

# Note: API keys (USDA, Perplexity) are now stored securely in Supabase Edge Functions
# Note: API keys (USDA, OpenAI) are now stored securely in Netlify Edge Functions
# and are NOT exposed to the client. Configure them in your Netlify dashboard.